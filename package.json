{
  "name": "synth-test",
  "version": "0.1.0",
  "description": "AI-driven UI testing tool. Write tests in plain English, let AI drive the browser.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "synth": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "audit": "npx better-npm-audit audit",
    "test": "vitest",
    "test:ci": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "testing",
    "ui-testing",
    "ai",
    "playwright",
    "browser-automation",
    "natural-language",
    "e2e"
  ],
  "author": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/vickism/synth.git"
  },
  "homepage": "https://github.com/vickism/synth#readme",
  "license": "MIT",
  "files": [
    "dist",
    "templates"
  ],
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.64",
    "@ai-sdk/azure": "^3.0.49",
    "@ai-sdk/openai": "^3.0.48",
    "ai": "^6.0.138",
    "commander": "^14.0.3",
    "picocolors": "^1.1.1",
    "playwright": "^1.58.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
